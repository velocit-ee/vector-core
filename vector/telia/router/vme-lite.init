#!/bin/sh /etc/rc.common
# Velocitee Vector — VME Lite OpenWrt Procd Service
# Starts and manages the bare-metal edge orchestrator daemon.

USE_PROCD=1
START=95
STOP=10

VME_DIR="/opt/vme-lite"
PROG="/usr/bin/python3"
DAEMON_SCRIPT="$VME_DIR/agent.py"
PORT="${VECTOR_ROUTER_PORT:-8088}"
HOST="${VECTOR_ROUTER_HOST:-0.0.0.0}"

start_service() {
    if [ ! -f "$PROG" ]; then
        echo "Error: Python 3 not found at $PROG. Install via 'opkg install python3'."
        return 1
    fi

    if [ ! -f "$DAEMON_SCRIPT" ]; then
        echo "Error: VME Lite agent not found at $DAEMON_SCRIPT."
        return 1
    fi

    # Ensure runtime scratch dir exists
    mkdir -p /tmp/telia-vector
    chmod 0750 /tmp/telia-vector

    procd_open_instance "vme-lite"
    procd_set_param command "$PROG" "$DAEMON_SCRIPT"
    procd_set_param env VECTOR_ROUTER_PORT="$PORT" VECTOR_ROUTER_HOST="$HOST" VECTOR_ASSETS_DIR="$VME_DIR/assets"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile /var/run/vme-lite.pid
    procd_close_instance
}

stop_service() {
    # Procd handles process termination automatically
    if [ -f /var/run/vme-lite.pid ]; then
        PID=$(cat /var/run/vme-lite.pid 2>/dev/null)
        [ -n "$PID" ] && kill -15 "$PID" 2>/dev/null
    fi
}

status_service() {
    if pgrep -f "$DAEMON_SCRIPT" >/dev/null 2>&1; then
        echo "VME Lite is running (Port $PORT)."
    else
        echo "VME Lite is stopped."
    fi
}
